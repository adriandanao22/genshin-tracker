# Copy to .env.local and fill in. Never commit real values.

# Stable random secret (32+ bytes). Encrypts the HoYoLAB session cookie AND
# derives the UID pseudonym key. Rotating it logs everyone out and orphans
# saved plans, so treat it as permanent. Generate: openssl rand -base64 48
HOYOLAB_SESSION_SECRET=

# Supabase (optional — omit both and the app runs localStorage-only).
# Server-side only: never prefix these with NEXT_PUBLIC_.
# Use the SECRET key (starts with "sb_secret_", or the legacy service_role JWT
# starting "eyJ..."). Do NOT use the publishable key ("sb_publishable_..." /
# legacy "anon") — it respects RLS and our table has no policies, so it can't
# read or write anything.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
